# Copy to .env (gitignored). Sourced automatically by the bash scripts.

SRAM_BROKER_URL=https://sram-s3.production.sdp.surf.nl
# Override for a different broker instance, e.g. playground or your own:
# SRAM_BROKER_URL=https://sram-s3.playground.sdp.surf.nl
# SRAM_BROKER_URL=http://localhost:8080

# Optional: pre-select a project role so you are not prompted to choose.
# SRAM_PROJECT=surf_demo:project2:members
